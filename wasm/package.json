{
  "name": "@codejoo/ffuzzy",
  "version": "0.3.1",
  "description": "Fast fuzzy search for the web — WASM port of the ffuzzy C engine. Five search modes, Unicode, TypeScript, browser + Node.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./ffuzzy.js",
      "types": "./ffuzzy.d.ts"
    },
    "./lite": {
      "import": "./ffuzzy-lite.js",
      "types": "./ffuzzy-lite.d.ts"
    }
  },
  "files": [
    "ffuzzy.js",
    "ffuzzy.d.ts",
    "ffuzzy-lite.js",
    "ffuzzy-lite.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "bash ../scripts/build-wasm.sh",
    "prepublishOnly": "node --input-type=module -e \"import{existsSync}from'node:fs';if(!existsSync('ffuzzy.js')){console.error('Run npm run build first');process.exit(1)}\""
  },
  "keywords": [
    "fuzzy-search",
    "fuzzy",
    "search",
    "matcher",
    "wasm",
    "webassembly",
    "typescript",
    "fzf",
    "nucleo",
    "unicode",
    "cjk",
    "subsequence",
    "fuzzy-matching",
    "autocomplete",
    "filter",
    "highlight",
    "browser",
    "node"
  ],
  "homepage": "https://github.com/icodejoo/ffuzzy",
  "repository": {
    "type": "git",
    "url": "https://github.com/icodejoo/ffuzzy.git",
    "directory": "wasm"
  },
  "bugs": {
    "url": "https://github.com/icodejoo/ffuzzy/issues"
  },
  "license": "MIT",
  "author": "jelon <jelon@tbu.net>",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  }
}
